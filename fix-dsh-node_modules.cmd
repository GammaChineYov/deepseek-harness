@echo off
setlocal
title dsh node_modules repair
rem ============================================================
rem  dsh repair: rebuild pnpm workspace links
rem  USE WHEN: "dsh web" fails with ERR_MODULE_NOT_FOUND
rem  (Cannot find package '@deepseek-ai/dsh-app-boot' ...)
rem  Run by double-click. No admin needed.
rem  Pure ASCII - do NOT add Chinese text here.
rem ============================================================

for /f "delims=" %%v in ('type "C:\Users\Landrom\.workbuddy\binaries\node\versions\current"') do set "WB_NODEVER=%%v"
set "NODE=C:\Users\Landrom\.workbuddy\binaries\node\versions\%WB_NODEVER%\node.exe"
set "PNPM=C:\Users\Landrom\.workbuddy\binaries\node\workspace\node_modules\pnpm\bin\pnpm.cjs"
set "REPO=G:\Tools\deepseek-harness"

if not exist "%NODE%" goto :nonode
if not exist "%PNPM%" goto :nonode

echo [1/3] Rebuilding node_modules links (pnpm install)...
echo      This takes a few minutes. Keep this window open.
cd /d "%REPO%"
"%NODE%" "%PNPM%" install --no-frozen-lockfile --reporter=append-only
if errorlevel 1 goto :fail

echo [2/3] Verifying workspace links...
if exist "%REPO%\node_modules\@deepseek-ai\dsh-app-boot" goto :verify_cli
if exist "%REPO%\apps\cli\node_modules\@deepseek-ai\dsh-app-boot" goto :verify_cli
goto :fail

:verify_cli
echo [3/3] Verifying cli can boot...
"%NODE%" "%REPO%\apps\cli\lib\bin.js" --version
if errorlevel 1 goto :fail

echo.
echo ============================================
echo   REPAIR OK. Now run:  dsh web
echo ============================================
pause
exit /b 0

:fail
echo.
echo ********** REPAIR FAILED **********
echo Check the pnpm error above. Likely causes:
echo   - Corporate network blocked npm registry
echo   - pnpm store corrupted (run: pnpm store prune)
echo   - Antivirus locked node_modules (temporarily disable)
pause
exit /b 1

:nonode
echo ERROR: managed node/pnpm not found at:
echo   %NODE%
echo   %PNPM%
echo If WorkBuddy was reinstalled, update the two paths at top of this script.
pause
exit /b 1
